      - title: en
        value: "1. H\u1EE3p t\xE1c nh\xF3m: \r\nGit cho ph\xE9p c\xE1c th\xE0nh vi\xEAn
          trong nh\xF3m ph\xE1t tri\u1EC3n d\u1EF1 \xE1n c\xF9ng l\xFAc m\xE0 kh\xF4ng
          can thi\u1EC7p v\xE0o c\xF4ng vi\u1EC7c c\u1EE7a nhau.\r\nV\xE0 c\xE1c
          th\xE0nh vi\xEAn c\xF3 th\u1EC3 d\u1EC5 d\xE0ng h\u1EE3p nh\u1EA5t c\xE1c
          t\u1EADp tin."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u5718\u968A\u5354\u4F5C\uFF1A\r\nGit \u5141\u8A31\u5718\u968A\u6210\u54E1\u540C\u6642\u9032\u884C\u5C08\u6848\u958B\u767C\r\n\u800C\u5F7C\u6B64\u7684\u5DE5\u4F5C\u4E0D\u6703\u4E92\u76F8\u5E72\u64FE\r\n\u540C\u6642\uFF0C\u5B83\u4E5F\u80FD\u5920\u8F15\u9B06\u5730\u5C07\u5404\u6210\u54E1\u7684\u6A94\u6848\u5408\u4F75\u5728\u4E00\u8D77"
