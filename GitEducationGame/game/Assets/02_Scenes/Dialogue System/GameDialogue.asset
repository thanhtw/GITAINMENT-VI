        typeString: CustomFieldType_Localization
      - title: zh
        value: "2. \u907F\u514D\u4F7F\u7528\u7279\u6B8A\u7B26\u865F\u3001\u4E2D\u6587\n\u5206\u652F\u540D\u7A31\u76E1\u91CF\u4E0D\u8981\u4F7F\u7528\u9019\u4E9B\u6587\u5B57\n\u4EE5\u78BA\u4FDD\u5C08\u6848\u80FD\u5920\u5728\u4E0D\u540C\u8A9E\u8A00\u7684\u8A2D\u5099\u4E0A\u958B\u767C\n\u4E5F\u8B93\u5718\u968A\u7406\u89E3\u5206\u652F\u7684\u4F5C\u7528"
