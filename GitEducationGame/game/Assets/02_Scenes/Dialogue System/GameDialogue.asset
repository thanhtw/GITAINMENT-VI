          tr\u1EEF t\u1EEB xa.\nB\u1EA1n c\u1EA7n n\u1ED1i th\xEAm \n'<color=#CF001C>remote_repository_alias</color>'
          v\xE0 '<color=#CF001C>local_branch_name</color>' \nsau l\u1EC7nh t\u01B0\u01A1ng
