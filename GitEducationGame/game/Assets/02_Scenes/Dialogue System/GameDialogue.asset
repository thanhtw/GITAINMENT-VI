        value: 
        type: 0
        typeString: 
      - title: en
        value: "1. X\xE1c nh\u1EADn b\xED danh kho l\u01B0u tr\u1EEF t\u1EEB xa n\u01A1i
          \u0111\u1EB7t nh\xE1nh m\u1EE5c ti\xEAu. N\xF3i chung l\xE0 'origin'. B\u1EA1n
          c\xF3 th\u1EC3 xem b\xED danh kho l\u01B0u tr\u1EEF th\xF4ng qua l\u1EC7nh
          Git. Vui l\xF2ng ki\u1EC3m tra H\u01B0\u1EDBng d\u1EABn tr\xF2 ch\u01A1i
          \u0111\u1EC3 bi\u1EBFt chi ti\u1EBFt."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u78BA\u8A8D\u76EE\u6A19\u5206\u652F\u6240\u5728\u7684\u9060\u7AEF\u5B58\u5132\u5EAB\u5225\u540D\n  
          \u4E00\u822C\u60C5\u6CC1\u4E0B\u662F 'origin'\n   \u53EF\u4EE5\u901A\u904E
          Git \u6307\u4EE4\u4F86\u67E5\u770B\u5132\u5B58\u5EAB\u5225\u540D\n   \u8A73\u7D30\u8ACB\u901A\u904E\u904A\u6232\u624B\u518A\u67E5\u627E"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 189
      isRoot: 0
