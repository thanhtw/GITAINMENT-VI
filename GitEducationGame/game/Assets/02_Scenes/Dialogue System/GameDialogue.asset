      - title: zh
        value: "2. Git \u6307\u4EE4\u4E2D\uFF0C\u6709\u500B\u5207\u63DB\u81F3\u5408\u4F75\u5206\u652F\u7684\u6307\u4EE4\r\n  
          \u9700\u8981\u5728\u6307\u4EE4\u5F8C\u65B9\u52A0\u5165\u5206\u652F\u540D\u7A31\r\n  
