        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "3. \u5728 Git \u6307\u4EE4\u4E2D\uFF0C\u6709\u500B\u5C07\u672C\u5730\u5206\u652F\u63A8\u5165\u9060\u7AEF\u5132\u5B58\u5EAB\u7684\u6307\u4EE4\n  
