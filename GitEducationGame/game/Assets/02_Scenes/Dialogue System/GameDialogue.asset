          t\xECm n\xFAt 'File Manager' tr\xEAn thanh c\xF4ng c\u1EE5 \u1EDF cu\u1ED1i
          tr\xF2 ch\u01A1i."
        type: 4
        typeString: CustomFieldType_Localization
