      - title: en
        value: "Looks like you might be having some trouble opening the 'Command
          Line' window. \r\nHere are some hints to help you reach your objective:"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u770B\u8D77\u4F86\u60A8\u53EF\u80FD\u5728\u958B\u555F '\u547D\u4EE4\u884C'
