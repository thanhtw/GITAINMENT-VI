        value: "\u70BA\u4E86\u5207\u63DB\u5230 'master' \u5206\u652F\u4EE5\u4FEE\u5FA9\u932F\u8AA4\u7684\u4F4D\u7F6E\r\n\u60A8\u9700\u8981\u57F7\u884C
