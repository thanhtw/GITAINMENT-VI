        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "2. \u958B\u555F '\u547D\u4EE4\u884C' \u8996\u7A97\r\n   \u4E26\u78BA\u8A8D\u8DEF\u5F91\u76EE\u524D\u4F4D\u65BC\u5C08\u6848\u4E0A"
