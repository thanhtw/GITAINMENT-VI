        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u7248\u672C\u63A7\u5236\u5728\u7A0B\u5F0F\u958B\u767C\u9818\u57DF\u4E2D\u662F\u91CD\u8981\u7684\u89D2\u8272\u4E4B\u4E00\r\n\u4F46\u5B83\u4E0D\u50C5\u50C5\u9069\u7528\u65BC\u7A0B\u5F0F\u76F8\u95DC\u9818\u57DF"
