        value: 
        type: 0
        typeString: 
      - title: en
        value: '2. Look for the button that opens the ''File Manager'' window.

          You
          can hover your mouse over the buttons to see what they do.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "2. \u5C0B\u627E\u4E00\u500B\u7528\u65BC\u958B\u555F '\u6A94\u6848\u7BA1\u7406'
          \u8996\u7A97\u7684\u6309\u9215\n   \u60A8\u53EF\u4EE5\u5C07\u6ED1\u9F20\u79FB\u52D5\u5230\u6309\u9215\u4E0A\u4EE5\u4E86\u89E3\u8A72\u6309\u9215\u7684\u4F5C\u7528"
