        typeString: 
      - title: en
        value: 'Looks like you are having some trouble modifying the file content.

          Here
          are some hints to help you reach your objective:'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u770B\u8D77\u4F86\u60A8\u5728\u4FEE\u6539\u6A94\u6848\u5167\u5BB9\u7684\u5730\u65B9\u9047\u5230\u4E86\u4E00\u4E9B\u554F\u984C\r\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\u5B8C\u6210\u76EE\u6A19\uFF1A"
