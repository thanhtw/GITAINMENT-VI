        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u78BA\u8A8D\u76EE\u6A19\u5206\u652F\u6240\u5728\u7684\u9060\u7AEF\u5B58\u5132\u5EAB\u5225\u540D\n  
          \u4E00\u822C\u60C5\u6CC1\u4E0B\u662F 'origin'\n   \u53EF\u4EE5\u901A\u904E
