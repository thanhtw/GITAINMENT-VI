        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u540C\u6B65\u672C\u5730\u3001\u9060\u7AEF\u5206\u652F\u6307\u4EE4\u5C31\u548C
          '<color=#CF001C>git merge</color>' \u985E\u4F3C\r\n   \u8F38\u5165\u7684\u9060\u7AEF\u5206\u652F\u540D\u7A31\u8981\u8207\u7576\u524D\u5C08\u6848\u6240\u5728\u5206\u652F\u76F8\u540C\r\n  
