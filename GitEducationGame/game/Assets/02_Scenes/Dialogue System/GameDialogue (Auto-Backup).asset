        value: "\u5F88\u597D\uFF01\n\u76EE\u524D\u672C\u5730 'master' \u5206\u652F\u5DF2\u540C\u6B65\u9060\u7AEF\u5206\u652F\n\u5DF2\u7372\u53D6\u5230\u5176\u4ED6\u5718\u968A\u6210\u54E1\u5408\u4F75\u7684\u63D0\u4EA4"
