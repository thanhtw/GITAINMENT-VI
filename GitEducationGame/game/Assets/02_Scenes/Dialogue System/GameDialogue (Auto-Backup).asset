        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5982\u679C\u60A8\u4E0D\u78BA\u5B9A\u5982\u4F55\u78BA\u8A8D '\u66AB\u5B58\u5340\u57DF'
          \u4E2D\u7684\u5167\u5BB9\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\u5B8C\u6210\u76EE\u6A19\uFF1A"
