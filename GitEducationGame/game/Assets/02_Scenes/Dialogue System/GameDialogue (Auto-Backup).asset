      - title: en
        value: "Ch\xFAng ta c\u1EA7n m\u1EDF c\u1EEDa s\u1ED5 'D\xF2ng l\u1EC7nh'
          \u0111\u1EC3 nh\u1EADp v\xE0 th\u1EF1c thi c\xE1c l\u1EC7nh Git tr\xEAn
          m\xE1y t\xEDnh.\n Vui l\xF2ng t\xECm n\xFAt 'D\xF2ng l\u1EC7nh' tr\xEAn
          thanh c\xF4ng c\u1EE5 \u1EDF cu\u1ED1i tr\xF2 ch\u01A1i.\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u6211\u5011\u8981\u958B\u555F '\u547D\u4EE4\u884C' \u8996\u7A97\n\u4EE5\u5728\u96FB\u8166\u4E2D\u8F38\u5165\u4E26\u57F7\u884C
          Git \u6307\u4EE4\n\u8ACB\u5728\u904A\u6232\u6B63\u4E0B\u65B9\u7684\u5DE5\u5177\u5217\u4E2D\u627E\u5230
          '\u547D\u4EE4\u884C' \u6309\u9215"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 170
      isRoot: 0
      isGroup: 0
