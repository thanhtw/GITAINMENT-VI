        typeString: CustomFieldType_Localization
      - title: zh
        value: "2. \u79FB\u52D5 '\u6A94\u6848\u7BA1\u7406' \u8996\u7A97\u7684\u8DEF\u5F91\n  
          \u76F4\u5230\u53EF\u4EE5\u5728 '\u6A94\u6848\u7BA1\u7406' \u8996\u7A97\u770B\u5230\u5C08\u6848\u88E1\u7684\u6240\u6709\u6A94\u6848\n  
