      - title: en
        value: "You can see a button with a folder icon. \nThat is the button to
          open the 'File Manager' window. \nPlease click it to open the window."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u60A8\u53EF\u4EE5\u770B\u5230\u6709\u8457\u8CC7\u6599\u593E\u5716\u793A\u7684\u6309\u9215\r\n\u5B83\u5C31\u662F\u958B\u555F
