      - title: en
        value: "Please go to the 'input command field' of the 'Command Line' window\r
          and type \r\n'<color=#CF001C>git --version</color>' or '<color=#CF001C>git
          -v</color>'.\r\nNote that the letter case must match exactly,\r\nand 'git'
          must be separated from '--version' by a space."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u8ACB\u5728 '\u547D\u4EE4\u5217' \u8996\u7A97\u7684 '\u8F38\u5165\u6307\u4EE4'
          \u5340\u57DF\n\u8F38\u5165 '<color=#CF001C>git --version</color>' \u6216'<color=#CF001C>git
          -v</color>'\n\u6CE8\u610F\u5927\u5C0F\u5BEB\u9700\u8981\u4E00\u81F4\n'git'
          \u548C '--version' \u4E4B\u9593\u7528\u7A7A\u683C\u5206\u96E2"
