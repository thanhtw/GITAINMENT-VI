        value: 
        type: 0
        typeString: 
      - title: en
        value: 'Backing up your files before making major changes is an excellent
          habit.

          This prevents data loss and makes it easy to restore
          everything to a previous state.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5728\u9032\u884C\u91CD\u8981\u7684\u4FEE\u6539\u4E4B\u524D\uFF0C\u5099\u4EFD\u662F\u4E00\u500B\u975E\u5E38\u597D\u7684\u7FD2\u6163\r\n\u9019\u6A23\u53EF\u4EE5\u9632\u6B62\u8CC7\u6599\u907A\u5931\u4E26\u4E14\u5BB9\u6613\u6062\u5FA9\u5230\u5148\u524D\u7684\u72C0\u614B"
