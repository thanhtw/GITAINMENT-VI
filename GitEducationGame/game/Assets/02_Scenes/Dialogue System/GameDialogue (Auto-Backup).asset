      - title: en
        value: 'If you are unsure how to synchronize local and remote branches,

          here
          are some hints to help you:'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5982\u679C\u60A8\u4E0D\u78BA\u5B9A\u5982\u4F55\u540C\u6B65\u672C\u5730\u3001\u9060\u7AEF\u5206\u652F\r\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\uFF1A"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 274
      isRoot: 0
      isGroup: 0
      nodeColor: 
