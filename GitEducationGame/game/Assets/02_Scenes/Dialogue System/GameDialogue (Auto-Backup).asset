      - title: en
        value: "C\xF3 v\u1EBB nh\u01B0 b\u1EA1n \u0111ang g\u1EB7p m\u1ED9t s\u1ED1
          kh\xF3 kh\u0103n khi m\u1EDF c\u1EEDa s\u1ED5 'D\xF2ng l\u1EC7nh'. \r\nD\u01B0\u1EDBi
          \u0111\xE2y l\xE0 m\u1ED9t s\u1ED1 g\u1EE3i \xFD gi\xFAp b\u1EA1n \u0111\u1EA1t
          \u0111\u01B0\u1EE3c m\u1EE5c ti\xEAu c\u1EE7a m\xECnh:"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u770B\u8D77\u4F86\u60A8\u53EF\u80FD\u5728\u958B\u555F '\u547D\u4EE4\u884C'
          \u8996\u7A97\u6642\u9047\u5230\u4E86\u4E00\u4E9B\u56F0\u96E3\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\u5B8C\u6210\u76EE\u6A19\uFF1A"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 169
      isRoot: 0
      isGroup: 0
