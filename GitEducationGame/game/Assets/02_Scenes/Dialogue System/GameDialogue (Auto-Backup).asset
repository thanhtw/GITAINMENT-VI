        value: 
        type: 0
        typeString: 
      - title: en
        value: "1. Among Git commands, \n'git add' and 'git reset' are used to add
          files to or remove them from the staging area.\nYou need to append the
          specified parameters afterward.\nPlease look them up in the Game Manual
          for details."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u5728 Git \u6307\u4EE4\u4E2D\uFF0C'git add' \u548C 'git reset'\r\n  
          \u5206\u5225\u64C1\u6709\u5C07\u6A94\u6848\u79FB\u5165\u3001\u79FB\u51FA\u66AB\u5B58\u5340\u57DF\u7684\u6307\u4EE4\r\n  
          \u60A8\u9700\u8981\u5728\u524D\u65B9\u52A0\u5165\u6307\u5B9A\u7684\u53C3\u6578\r\n  
          \u8A73\u7D30\u8ACB\u901A\u904E\u904A\u6232\u624B\u518A\u67E5\u627E"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 256
