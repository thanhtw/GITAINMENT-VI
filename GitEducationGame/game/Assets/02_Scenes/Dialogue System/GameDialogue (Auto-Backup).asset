      - title: en
        value: "If you are unsure how to check the contents of the 'Commit History',\r\nhere
          are some hints to help you reach your objective:\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5982\u679C\u60A8\u4E0D\u78BA\u5B9A\u5982\u4F55\u67E5\u770B\u63D0\u4EA4\u8A18\u9304\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\u5B8C\u6210\u76EE\u6A19\uFF1A"
        type: 4
        typeString: CustomFieldType_Localization
