        value: 
        type: 0
        typeString: 
      - title: en
        value: 'We need to open the ''File Manager'' window.

          This will
          allow us to view all the files contained in this simulated computer.

          Please
          find the ''File Manager'' button in the toolbar at the bottom of the game.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u6211\u5011\u8981\u958B\u555F '\u6A94\u6848\u7BA1\u7406' \u8996\u7A97\r\n\u4EE5\u67E5\u770B\u9019\u500B\u6A21\u64EC\u96FB\u8166\u5305\u542B\u7684\u6240\u6709\u6A94\u6848\r\n\u8ACB\u5728\u904A\u6232\u6B63\u4E0B\u65B9\u7684\u5DE5\u5177\u5217\u4E2D\u627E\u5230
          '\u6A94\u6848\u7BA1\u7406' \u6309\u9215"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 251
