      - title: en
        value: 'To add the ''Git_Learning_Diary.txt'' file to Git''s staging area,

          you
          need to execute the ''<color=#CF001C>git add Git_Learning_Diary.txt</color>''
          command.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
