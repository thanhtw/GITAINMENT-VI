        typeString: 
      - title: en
        value: 'Looks like you are not quite sure how to achieve the objective for
          this stage.

          Here are some hints to help you:'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u770B\u4F86\u60A8\u4E0D\u592A\u6E05\u695A\u5982\u4F55\u9054\u6210\u672C\u6B21\u7684\u76EE\u6A19\r\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\uFF1A"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 256
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
