      - title: en
        value: 'If you are unsure how to create a new commit to save your project
          version,

          here are some hints to help you reach your objective:'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5982\u679C\u60A8\u4E0D\u78BA\u5B9A\u5982\u4F55\u65B0\u589E\u63D0\u4EA4\u4F86\u4FDD\u5B58\u60A8\u7684\u5C08\u6848\u7248\u672C\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\u5B8C\u6210\u76EE\u6A19\uFF1A"
