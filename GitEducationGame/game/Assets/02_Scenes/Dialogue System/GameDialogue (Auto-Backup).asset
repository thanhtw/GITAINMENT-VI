      - title: en
        value: "N\u1EBFu b\u1EA1n kh\xF4ng ch\u1EAFc ch\u1EAFn v\u1EC1 c\xE1ch \u0111i\u1EC1u
          h\u01B0\u1EDBng \u0111\u1EBFn \u0111\u01B0\u1EDDng d\u1EABn d\u1EF1 \xE1n
          c\u1EA7n \u0111\u01B0\u1EE3c qu\u1EA3n l\xFD, \nth\xEC \u0111\xE2y l\xE0
          m\u1ED9t s\u1ED1 g\u1EE3i \xFD gi\xFAp b\u1EA1n \u0111\u1EA1t \u0111\u01B0\u1EE3c
          m\u1EE5c ti\xEAu c\u1EE7a m\xECnh:\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5982\u679C\u60A8\u4E0D\u78BA\u5B9A\u5982\u4F55\u79FB\u52D5\u5230\u9700\u8981\u7BA1\u7406\u7684\u5C08\u6848\u8DEF\u5F91\n\u9019\u88E1\u6709\u4E00\u4E9B\u63D0\u793A\u53EF\u4EE5\u5E6B\u52A9\u60A8\u5B8C\u6210\u76EE\u6A19\uFF1A"
