      - title: en
        value: "This command will create a new Git management system at the current
          command line path.\r\nPlease make sure the command line path is \n'<color=#CF001C>Home
          > My_Web_Project</color>'\r\nso that it won't track unrelated files."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u9019\u500B\u6307\u4EE4\u6703\u5728\u547D\u4EE4\u884C\u8DEF\u5F91\u4E0B\u5275\u5EFA\u65B0\u7684
