          This will delete the specified
          remote branch from the remote repository.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u5728 '\u5275\u5EFA\u9060\u7AEF\u5206\u652F' \u6307\u4EE4\u4E2D\u52A0\u5165
