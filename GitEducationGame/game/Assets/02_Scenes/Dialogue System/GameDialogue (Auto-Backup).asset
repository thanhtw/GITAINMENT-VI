      - title: en
        value: '4. Before modifying any content,

          please make sure the
          file name matches the current objective.'
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "4. \u4FEE\u6539\u5167\u5BB9\u4E4B\u524D\r\n   \u8ACB\u6CE8\u610F\u8981\u4FEE\u6539\u5167\u5BB9\u7684\u6A94\u6848\u540D\u7A31\u8981\u7B26\u5408\u7576\u524D\u76EE\u6A19"
