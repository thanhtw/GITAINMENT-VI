        typeString: 
      - title: en
        value: "1. Please find the toolbar in the game. \nIt is located at the bottom
          of the screen."
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u8ACB\u627E\u5230\u904A\u6232\u4E2D\u7684\u5DE5\u5177\u6B04\uFF0C\u5B83\u4F4D\u65BC\u904A\u6232\u756B\u9762\u7684\u6B63\u4E0B\u65B9"
        type: 4
        typeString: CustomFieldType_Localization
      conversationID: 173
      isRoot: 0
