        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "\u6211\u5011\u6839\u64DA\u4FEE\u6539\u5EFA\u8B70\u4FEE\u6539\u4E86\u5167\u5BB9\r\n\u73FE\u5728\u61C9\u8A72\u5C07\u9019\u4E9B\u5167\u5BB9\u518D\u6B21\u4E0A\u50B3\u5230\u9060\u7AEF
          'update-readme' \u5206\u652F\u4E0A\r\n\u9019\u9EBC\u505A\u7684\u8A71\uFF0C\u5C07\u6703\u66F4\u65B0
