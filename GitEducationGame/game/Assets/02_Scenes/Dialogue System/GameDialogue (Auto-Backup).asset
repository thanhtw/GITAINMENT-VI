        value: 
        type: 0
        typeString: 
      - title: en
        value: "1. Vui l\xF2ng t\xECm thanh c\xF4ng c\u1EE5 trong tr\xF2 ch\u01A1i.
          N\xF3 n\u1EB1m \u1EDF d\u01B0\u1EDBi c\xF9ng c\u1EE7a m\xE0n h\xECnh.\r"
        type: 4
        typeString: CustomFieldType_Localization
      - title: zh
        value: "1. \u8ACB\u627E\u5230\u904A\u6232\u4E2D\u7684\u5DE5\u5177\u6B04\uFF0C\u5B83\u4F4D\u65BC\u904A\u6232\u756B\u9762\u7684\u6B63\u4E0B\u65B9"
