        typeString: CustomFieldType_Localization
      - title: zh
        value: "2. \u78BA\u8A8D\u60A8\u8981\u4E0A\u50B3\u7684\u6307\u5B9A\u9060\u7AEF\u5B58\u5132\u5EAB\u5225\u540D\n  
          \u4E00\u822C\u60C5\u6CC1\u4E0B\u662F 'origin'\n   \u53EF\u4EE5\u901A\u904E
